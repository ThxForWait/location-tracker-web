# Скопируйте в .env и заполните. Файл .env не хранится в git.

# True только для локальной разработки
DJANGO_DEBUG=False
# Сгенерировать: uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Через запятую
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Приложение Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Минимальный возраст Discord-аккаунта для получения токена, дней
DISCORD_MIN_ACCOUNT_AGE_DAYS=30

# Граф статичных переходов законсервирован (принимать только эталонные рёбра)
TRACKER_STATIC_GRAPH_FROZEN=False
# Минимальная версия клиента трекера
TRACKER_MIN_CLIENT_VERSION=0.0.0
